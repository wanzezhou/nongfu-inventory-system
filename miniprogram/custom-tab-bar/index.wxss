/* 自定义 tabBar 样式（本文件由脚本生成，改图标请改 SVG 定义后重跑）
   ==========================================================================
   图标 = 内联 SVG data URI：好处是仓库里不需要放任何二进制图片资源，
   且颜色只在这里出现一次；微信开发者工具与真机均支持。
   ========================================================================== */

.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  background: #ffffff;
  border-top: 2rpx solid #eef0f3;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 100;
}

.tabbar-item {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 108rpx;
}
.tabbar-item:active { background: #fafafb; }

.tabbar-icon {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.tabbar-text {
  font-size: 22rpx;
  color: #8a8f99;
  margin-top: 4rpx;
  line-height: 1.2;
}
.is-active .tabbar-text { color: #c8102e; font-weight: 600; }

.tabbar-badge {
  position: absolute;
  top: 8rpx;
  left: 50%;
  margin-left: 8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 6rpx;
  border-radius: 15rpx;
  background: #c8102e;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}


.section-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f2f3f7;
}

.form-label {
  font-size: 26rpx;
  color: #5f6672;
  width: 180rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
}

.picker-value {
  font-size: 26rpx;
  color: #333a45;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.kv-k {
  color: #8a919e;
  font-size: 26rpx;
}

.kv-v {
  font-size: 26rpx;
}

.tx-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx solid #f2f3f7;
}

.tx-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  max-width: 55%;
}

.tx-cat {
  font-size: 26rpx;
}

.tx-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.amt-in {
  color: #c8102e;
  font-size: 28rpx;
  font-weight: 600;
}

.amt-out {
  color: #0f8a4d;
  font-size: 28rpx;
  font-weight: 600;
}

.save-btn {
  margin-top: 24rpx;
}

.action-btn {
  margin-top: 16rpx;
}

.btn-danger {
  background: #c0392b;
  color: #ffffff;
}

.bottom-space {
  height: 60rpx;
}

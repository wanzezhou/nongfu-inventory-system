<!-- 账户 新增 / 编辑（管理员 · Phase 8b 第 10 域）
     ⚠️ 编辑态下：名称 / 类型 / 余额都是**只读展示** ——
        名称是唯一键、类型参与统计口径、余额只能由业务单据或转账变动。
        可改的只有开户信息 / 备注 / 状态。 -->
<view class="page">
  <view wx:if="{{loadError}}" class="banner banner-danger">{{loadError}}</view>
  <view wx:if="{{formError}}" class="banner banner-danger">{{formError}}</view>
  <view wx:if="{{loading}}" class="t-sub center">加载中…</view>

  <block wx:if="{{!loading}}">
    <!-- 新增：名称 + 类型 + 期初 -->
    <view wx:if="{{!isEdit}}" class="card">
      <view class="section-title">新增账户</view>
      <view class="form-row">
        <text class="form-label">账户名称</text>
        <input class="form-input" placeholder="必填，不可与已有账户重名" value="{{form.accountName}}" data-field="accountName" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="form-label">账户类型</text>
        <picker mode="selector" range="{{typeLabels}}" value="{{typeIndex}}" bindchange="onTypeChange">
          <view class="picker-value">{{typeLabels[typeIndex] || '请选择'}} ›</view>
        </picker>
      </view>
      <view class="form-row">
        <text class="form-label">期初余额</text>
        <input class="form-input" type="digit" placeholder="默认 0，创建后不可直接修改" value="{{form.initialBalance}}" data-field="initialBalance" bindinput="onInput" />
      </view>
    </view>

    <!-- 编辑：只读信息 + 可改字段 -->
    <block wx:else>
      <view class="card">
        <view class="row-between">
          <text class="t-strong">{{account.accountName}}</text>
          <text class="t-strong">¥{{balanceText}}</text>
        </view>
        <view class="kv mt-8"><text class="kv-k">账户编号</text><text class="kv-v">{{account.accountId}}</text></view>
        <view class="kv"><text class="kv-k">账户类型</text><text class="kv-v">{{account.accountTypeName}}</text></view>
        <view class="kv"><text class="kv-k">期初余额</text><text class="kv-v">¥{{initialText}}</text></view>
      </view>
      <view class="card">
        <view class="t-sub">
          余额只能由业务单据或转账变动，本页不提供修改入口（名称与类型同样不可改）。
        </view>
      </view>
    </block>

    <view class="card">
      <view class="form-row">
        <text class="form-label">开户银行</text>
        <input class="form-input" placeholder="选填" value="{{form.bankName}}" data-field="bankName" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="form-label">银行账号</text>
        <input class="form-input" placeholder="选填" value="{{form.bankAccount}}" data-field="bankAccount" bindinput="onInput" />
      </view>
      <view class="form-row">
        <text class="form-label">备注</text>
        <input class="form-input" placeholder="选填" value="{{form.remark}}" data-field="remark" bindinput="onInput" />
      </view>
      <view wx:if="{{isEdit}}" class="form-row">
        <text class="form-label">账户状态</text>
        <switch checked="{{form.status}}" bindchange="onStatusChange" color="#c8102e" />
      </view>
    </view>

    <!-- 编辑态：近期流水 -->
    <view wx:if="{{isEdit && transactions.length}}" class="card">
      <view class="section-title">近期流水（最近 20 条）</view>
      <view wx:for="{{transactions}}" wx:key="txNo" class="tx-row">
        <view class="tx-left">
          <text class="tx-cat">{{item.txCategory || item.txTypeName}}</text>
          <text class="t-sub">{{item.txDate}} · {{item.counterparty || '—'}}</text>
        </view>
        <view class="tx-right">
          <text class="{{item.txType === 1 ? 'amt-in' : 'amt-out'}}">{{item.txType === 1 ? '+' : '−'}}¥{{item.amountText}}</text>
          <text class="t-sub">余 ¥{{item.balanceAfterText}}</text>
        </view>
      </view>
    </view>

    <!-- 编辑态：删除（仅在「余额 0 且无流水」时服务端才允许） -->
    <view wx:if="{{isEdit}}" class="card">
      <view class="section-title">删除账户</view>
      <view class="t-sub">
        只有「余额为 0 且无任何流水」的账户能删除；否则请用上面的状态开关停用。
      </view>
      <view class="btn btn-danger action-btn" bindtap="onRemove">删除该账户</view>
    </view>

    <view class="btn save-btn" bindtap="onSubmit" disabled="{{submitting}}">{{submitting ? '提交中…' : (isEdit ? '保存' : '创建账户')}}</view>
    <view class="bottom-space"></view>
  </block>
</view>

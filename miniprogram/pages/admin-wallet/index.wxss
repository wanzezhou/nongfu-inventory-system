/* 管理员 · 积分钱包后台 */
.hero-sm {
  margin: 24rpx;
  padding: 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #c8102e 0%, #a30d24 100%);
  color: #ffffff;
}
.hs-label { font-size: 24rpx; opacity: 0.86; }
.hs-value { font-size: 60rpx; font-weight: 700; line-height: 1.15; }
.hs-sub { font-size: 22rpx; opacity: 0.84; margin-top: 6rpx; }

.filter-bar {
  white-space: nowrap;
  background: #ffffff;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #eef0f3;
}
.filter-item {
  display: inline-block;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 26rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: #f2f3f5;
  color: #5a6371;
  font-size: 26rpx;
}
.filter-item.is-active { background: #fdecee; color: #c8102e; font-weight: 600; }

.seg {
  display: flex;
  background: #f2f3f5;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 12rpx;
}
.seg-item {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 28rpx;
  color: #5a6371;
  border-radius: 10rpx;
}
.seg-item.is-active {
  background: #ffffff;
  color: #c8102e;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(24, 28, 35, 0.08);
}

.tx-row {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
  font-size: 26rpx;
}
.tx-row + .tx-row { border-top: 2rpx solid #f7f8fa; }

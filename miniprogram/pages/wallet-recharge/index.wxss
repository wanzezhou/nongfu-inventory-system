/* 充值 */
.way-row {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
}
.way-row + .way-row { border-top: 2rpx solid #f7f8fa; }
.way-idx {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  border-radius: 22rpx;
  background: #fdecee;
  color: #c8102e;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 44rpx;
}

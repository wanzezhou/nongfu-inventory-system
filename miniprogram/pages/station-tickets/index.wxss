/* 我的水票 */
.ticket-hero {
  margin: 24rpx;
  padding: 40rpx 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #c8102e 0%, #a30d24 100%);
  color: #ffffff;
}
.th-label { font-size: 24rpx; opacity: 0.86; }
.th-value { font-size: 72rpx; font-weight: 700; line-height: 1.15; }
.th-sub { font-size: 22rpx; opacity: 0.82; margin-top: 8rpx; }

.tk-thumb {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f3f5;
}
.tk-img { width: 120rpx; height: 120rpx; }
.tk-ph {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #c8102e;
  background: #fdecee;
}

.tk-months {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f2f3f5;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.tk-month {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 14rpx;
  background: #f7f8fa;
  border-radius: 8rpx;
  font-size: 22rpx;
}
.tk-month-name { color: #5a6371; }
.tk-month-count { color: #1f2329; font-weight: 600; }

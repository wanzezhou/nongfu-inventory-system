<!-- 我的水票 -->
<view class="page">

  <view class="ticket-hero">
    <view class="th-label">可用水票合计</view>
    <view class="th-value">{{totalAvailable}}</view>
    <view class="th-sub">下单时可按商品明细选择抵扣数量（支持部分抵扣）</view>
  </view>

  <view wx:if="{{loading}}" class="empty">加载中…</view>
  <view wx:elif="{{list.length === 0}}" class="empty">
    <view class="empty-icon">🎫</view>
    <view wx:if="{{loadError}}">{{loadError}}</view>
    <view wx:else>暂无可用水票</view>
    <button class="btn btn-primary btn-sm mt-24" bindtap="goMall">去订货</button>
  </view>

  <block wx:else>
    <view wx:for="{{list}}" wx:key="productId" class="list-item">
      <view class="row">
        <view class="tk-thumb">
          <image wx:if="{{item.imageFull}}" src="{{item.imageFull}}" mode="aspectFill" class="tk-img" />
          <view wx:else class="tk-ph">{{item.initial}}</view>
        </view>
        <view class="flex-1" style="margin-left: 20rpx;">
          <view class="t-strong">{{item.productName}}</view>
          <view class="t-sub mt-8">{{item.specification || '—'}} · {{item.unit || '件'}}</view>
          <view class="row-between mt-8">
            <text class="t-sub">分销价 ¥{{item.wholesalePriceText}}</text>
            <text class="t-primary t-strong">可用 {{item.availableQty}} 张</text>
          </view>
        </view>
      </view>

      <view class="tk-months">
        <view wx:for="{{item.months}}" wx:for-item="m" wx:key="month" class="tk-month">
          <text class="tk-month-name">{{m.month}}</text>
          <text class="tk-month-count">{{m.count}} 张</text>
          <text class="tag {{m.label === '未用' ? 'tag-ok' : 'tag-plain'}}">{{m.label}}</text>
        </view>
      </view>

      <view class="t-sub mt-16">
        已核销 {{item.usedQty}} 张 · 作废 {{item.voidQty}} 张
      </view>
    </view>

    <view class="banner banner-info">
      水票发行产生的分销配送费积分属 Phase 7，本期尚未接入钱包（数据库中单件值/总额列已按文档 §20.4 预置）。
    </view>
  </block>
</view>

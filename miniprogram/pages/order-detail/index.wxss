/* 订单详情 */
.status-head {
  margin: 24rpx;
  padding: 36rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #c8102e 0%, #a30d24 100%);
  color: #ffffff;
}
.status-label { font-size: 40rpx; font-weight: 700; }
.status-sub { font-size: 24rpx; opacity: 0.86; margin-top: 8rpx; }

.od-item + .od-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #f2f3f5;
}
.od-thumb {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f3f5;
}
.od-img { width: 120rpx; height: 120rpx; }
.od-ph {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
  color: #c8102e;
  background: #fdecee;
}

.kv {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}
.kv-k { color: #8a8f99; flex-shrink: 0; margin-right: 24rpx; }
.kv-v { color: #1f2329; text-align: right; flex: 1; word-break: break-all; }

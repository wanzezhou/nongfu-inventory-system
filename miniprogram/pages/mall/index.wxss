/* 商城 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  position: sticky;
  top: 0;
  z-index: 10;
}
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  background: #f2f3f5;
  border-radius: 34rpx;
  padding: 0 24rpx;
}
.search-input { flex: 1; font-size: 26rpx; }
.search-clear { color: #b6bbc4; font-size: 26rpx; padding: 0 8rpx; }
.search-btn { font-size: 28rpx; color: #c8102e; font-weight: 600; }

.cat-bar {
  white-space: nowrap;
  background: #ffffff;
  padding: 0 24rpx 20rpx;
  border-bottom: 2rpx solid #eef0f3;
}
.cat-item {
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 28rpx;
  background: #f2f3f5;
  color: #5a6371;
  font-size: 26rpx;
}
.cat-item.is-active { background: #fdecee; color: #c8102e; font-weight: 600; }
.cat-count { font-size: 20rpx; margin-left: 6rpx; opacity: 0.7; }

.goods {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(24, 28, 35, 0.05);
}
.goods:active { background: #fafafb; }
.goods-thumb {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f3f5;
}
.goods-img { width: 160rpx; height: 160rpx; }
.goods-ph {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #c8102e;
  background: #fdecee;
  font-weight: 700;
}
.goods-body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.goods-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2329;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.goods-spec { font-size: 22rpx; color: #8a8f99; margin-top: 6rpx; }
.goods-price-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}
.goods-price { font-size: 32rpx; font-weight: 700; color: #c8102e; }
.goods-price-label { font-size: 20rpx; color: #8a8f99; font-weight: 400; }
.goods-min { font-size: 20rpx; color: #b8730a; margin-top: 4rpx; }
.goods-add {
  height: 56rpx;
  padding: 0 26rpx;
  border-radius: 28rpx;
  background: #c8102e;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 56rpx;
}
.goods-add:active { opacity: 0.85; }

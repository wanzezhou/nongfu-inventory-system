<!-- 小程序账号管理（管理员 · 运维域）
     ⚠️ 本页最容易误操作的是「禁用 / 解绑」的区别，故两个确认框都把差异写在正文里。 -->
<view class="page">
  <view wx:if="{{loadError}}" class="banner banner-danger">{{loadError}}</view>
  <view wx:if="{{notice}}" class="banner banner-info">{{notice}}</view>

  <view class="card">
    <view class="row-between">
      <text class="t-sub">角色</text>
      <picker mode="selector" range="{{roleLabels}}" value="{{roleIndex}}" bindchange="onRoleChange">
        <view class="row-between">
          <text class="t-strong">{{roleLabels[roleIndex]}}</text>
          <text class="t-sub">›</text>
        </view>
      </picker>
    </view>
    <view class="divider"></view>
    <view class="row-between">
      <text class="t-sub">状态</text>
      <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onStatusChange">
        <view class="row-between">
          <text class="t-strong">{{statusLabels[statusIndex]}}</text>
          <text class="t-sub">›</text>
        </view>
      </picker>
    </view>
    <view class="divider"></view>
    <view class="row-between">
      <text class="t-sub">关键词</text>
      <input class="form-input" style="width: 320rpx" value="{{keyword}}" bindinput="onKeywordInput" placeholder="手机号 / 昵称" />
    </view>
    <view class="mt-8 row-between">
      <text class="t-sm t-sub">共 {{total}} 条 · 第 {{page}} 页</text>
      <view>
        <text class="t-primary" bindtap="onPrevPage">上一页</text>
        <text class="t-primary" style="margin-left: 24rpx" bindtap="onNextPage">下一页</text>
        <text class="t-primary" style="margin-left: 24rpx" bindtap="onSearch">查询</text>
      </view>
    </view>
  </view>

  <!-- 改绑面板：选中某账号后出现 -->
  <view wx:if="{{rebindId}}" class="card">
    <view class="row-between">
      <text class="t-strong">改绑 {{rebindName}}</text>
      <text class="t-sub" bindtap="onCancelRebind">取消</text>
    </view>
    <view class="divider"></view>
    <view class="row-between">
      <text class="t-sub">新绑定主体</text>
      <picker mode="selector" range="{{bindLabels}}" value="{{bindIndex}}" bindchange="onBindChange">
        <view class="row-between">
          <text class="t-strong">{{bindLabels[bindIndex] || '请选择'}}</text>
          <text class="t-sub">›</text>
        </view>
      </picker>
    </view>
    <view class="t-sm t-sub mt-8">改绑后对方需重新登录（旧令牌立即失效）；钱包余额按主体保留。</view>
    <view class="mt-16">
      <button class="btn save-btn" loading="{{busy}}" bindtap="onConfirmRebind">确认改绑</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="t-sub center">加载中…</view>
  <view wx:elif="{{!list.length}}" class="empty">
    <text class="empty-icon">👤</text>
    <text class="t-sub">没有符合条件的账号</text>
  </view>

  <view wx:for="{{list}}" wx:key="accountId" class="card">
    <view class="row-between">
      <text class="t-strong">{{item.subjectName || item.nickname || '（未命名）'}}</text>
      <text class="{{item.status === 1 ? 't-primary' : 't-sub'}}">{{item.status === 1 ? '启用' : '禁用'}}</text>
    </view>
    <view class="t-sm t-sub mt-8">
      {{item.roleLabel}} · 账号 {{item.accountId}} · 手机 {{item.phoneMasked || '—'}}
    </view>
    <view class="t-sm t-sub mt-8">主体 {{item.targetId || '—'}} · 末次登录 {{item.lastLoginAt || '—'}}</view>

    <block wx:if="{{item.operable}}">
      <view class="divider"></view>
      <view class="row-between">
        <text
          class="t-primary"
          data-id="{{item.accountId}}"
          data-status="{{item.status}}"
          data-name="{{item.subjectName}}"
          bindtap="onToggleStatus"
        >{{item.status === 1 ? '禁用' : '启用'}}</text>
        <text
          class="t-primary"
          data-id="{{item.accountId}}"
          data-name="{{item.subjectName}}"
          data-role-label="{{item.roleLabel}}"
          bindtap="onOpenRebind"
        >改绑定</text>
        <text class="t-primary" data-id="{{item.accountId}}" data-name="{{item.subjectName}}" bindtap="onUnbind">解绑</text>
      </view>
    </block>
    <view wx:else class="t-sm t-sub mt-8">管理员账号不在此处管理（请到 Web 后台操作）</view>
  </view>
  <view class="mt-24"></view>
</view>

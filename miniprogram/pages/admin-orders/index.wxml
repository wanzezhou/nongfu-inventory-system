<!-- 订单管理 · 列表（管理员 · Phase 8b 第 9 域）
     ⚠️ 全来源订单（Web 建的现金单也在列）—— 管理员要推进的是整个系统的履约状态，
        不是只有小程序单。列表项点进详情做推进/取消操作。 -->
<view class="page">
  <view wx:if="{{loadError}}" class="banner banner-danger">{{loadError}}</view>

  <!-- 筛选：状态 tabs + 关键词 -->
  <view class="card">
    <scroll-view scroll-x class="tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="tab {{status === item.key ? 'is-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTab"
      >{{item.label}}</view>
    </scroll-view>
    <view class="search-row">
      <input
        class="search-input"
        placeholder="订单号 / 客户名 / 电话"
        value="{{keyword}}"
        confirm-type="search"
        bindinput="onKeywordInput"
        bindconfirm="onSearch"
      />
      <view class="btn btn-sm" bindtap="onSearch">搜索</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="t-sub center">加载中…</view>
  <view wx:elif="{{!list.length && !loading}}" class="empty">
    <text class="empty-icon">📦</text>
    <text class="t-sub">没有符合条件的订单</text>
  </view>

  <view class="order-list">
    <view
      wx:for="{{list}}"
      wx:key="orderId"
      class="card order-item"
      data-id="{{item.orderId}}"
      bindtap="goDetail"
    >
      <view class="row-between">
        <text class="t-strong">{{item.customerName || '—'}}</text>
        <text class="status-tag s-{{item.fulfillmentStatus}}">{{item.fulfillmentStatusLabel}}</text>
      </view>
      <view class="row-between mt-8">
        <text class="t-sub">{{item.orderId}}</text>
        <text class="t-strong">¥{{item.orderAmountText}}</text>
      </view>
      <view class="row-between mt-8">
        <text class="t-sub">{{item.itemCount}} 件商品 · {{item.createdAtText}}</text>
        <text wx:if="{{item.refunded}}" class="status-tag s-refund">已退款</text>
      </view>
    </view>
  </view>

  <view wx:if="{{hasMore}}" class="load-more t-sub" bindtap="loadMore">加载更多</view>
  <view class="bottom-space"></view>
</view>

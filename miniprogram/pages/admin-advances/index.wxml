<!-- 工资预支台账（管理员 · Phase 8b 第 11 域）
     ⚠️ 预支登记即扣公司账户（公司先把钱给出去了）；发放时才把挂账抵扣掉 —— 两件事，别混。 -->
<view class="page">
  <view wx:if="{{loadError}}" class="banner banner-danger">{{loadError}}</view>

  <view class="card">
    <view class="form-row">
      <text class="form-label">员工</text>
      <picker mode="selector" range="{{workerLabels}}" value="{{workerIndex}}" bindchange="onWorkerChange">
        <view class="row-between">
          <text class="t-strong">{{workerLabels[workerIndex]}}</text>
          <text class="t-sub">›</text>
        </view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">状态</text>
      <picker mode="selector" range="{{statusLabels}}" value="{{statusIndex}}" bindchange="onStatusChange">
        <view class="row-between">
          <text class="t-strong">{{statusLabels[statusIndex]}}</text>
          <text class="t-sub">›</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="t-sub">共 {{total}} 笔预支</text>
      <text class="t-primary" bindtap="goCreate">＋ 登记预支 ›</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="t-sub center">加载中…</view>
  <view wx:elif="{{!list.length && !loading}}" class="empty">
    <text class="empty-icon">📝</text>
    <text class="t-sub">没有符合条件的预支记录</text>
  </view>

  <view wx:for="{{list}}" wx:key="advanceId" class="card">
    <view class="row-between">
      <text class="t-strong">{{item.workerName}}</text>
      <text class="t-strong">¥{{item.amountText}}</text>
    </view>
    <view class="row-between mt-8">
      <text class="t-sm t-sub">{{item.advanceDate}} · 已抵 ¥{{item.deductedText}}</text>
      <text wx:if="{{item.settled}}" class="tag tag-primary">已结清</text>
      <text wx:else class="tag tag-warn">未结清 ¥{{item.pendingText}}</text>
    </view>
    <view class="t-sub mt-8" wx:if="{{item.remark}}">备注：{{item.remark}}</view>
    <view class="divider"></view>
    <view class="row-between">
      <text wx:if="{{item.canRevoke}}" class="t-sm t-sub">未参与结算，可撤销</text>
      <text wx:else class="t-sm t-sub">已参与结算，需先撤销对应月份发放</text>
      <text wx:if="{{item.canRevoke}}" class="t-primary" data-id="{{item.advanceId}}" bindtap="onRevoke">撤销</text>
    </view>
  </view>
  <view class="mt-24"></view>
</view>

#!/bin/sh
# 本地提交门禁（G2 机器门禁 · 秒级）
# =====================================================================
# 设计原则：只查「改动文件」，全量检查放 CI。
# 详见 docs/代码审查标准.md、docs/代码审查流程.md 第四章 G2
set -e

# ⚠️ `-c core.quotepath=false` 不可省：git 默认会把非 ASCII 路径转义成 `"\345\225\206..."`，
#    于是下面 `商品档案/` 这条守卫拿到的是转义串、**永远匹配不到** —— 守卫形同虚设。
#    关掉 quotepath 后中文路径原样输出，守卫才真正生效。
STAGED=$(git -c core.quotepath=false diff --cached --name-only --diff-filter=ACM)

# ── 1. 敏感文件阻断（防止运行期私密内容或密钥进仓库）────────────────
# ⚠️ 2026-09-20 修门禁自身缺陷：原实现是 `for p in ...; grep -q "^${p}"`，
#    属于**裸前缀匹配**，`backend/.env` 会命中 `backend/.env.example` ——
#    即「提交示例环境变量文件」这种完全合法的操作被误拦。
#    误报的代价不只是不便：它会把开发者推向 `--no-verify`，那才是真正危险的。
#
#    改为逐个文件 `case` 判断，分两类：
#      ① 明确的私密路径：整串相等，或以该路径为父目录（.env / backend/.env / uploads / 商品档案）
#      ② `.env.<后缀>` 一族：**默认拦**（.env.local / .env.production / .env.bak …），
#         只放行登记用的三种示例后缀 .example / .sample / .template
#    ⚠️ 不能图省事用 `^\.env` 一把扫：那正是误拦 .env.example 的原因；
#       也不能只写 `.env` 精确匹配：那会漏掉 .env.local（收窄时实测踩到过）。
#    （`case` 是 POSIX 内建、按字面 glob 比较，没有正则元字符被误解释的余地。）
blocked_path=''
while IFS= read -r staged_path; do
  [ -z "$staged_path" ] && continue
  case "$staged_path" in
    .env|.env/*|backend/.env|backend/.env/*|backend/uploads/*|商品档案|商品档案/*)
      blocked_path="$staged_path"
      ;;
    .env.*|backend/.env.*)
      case "$staged_path" in
        *.example|*.sample|*.template) ;;                 # 登记用示例文件，允许入库
        *) blocked_path="$staged_path" ;;
      esac
      ;;
  esac
  [ -n "$blocked_path" ] && break
done <<STAGED_LIST
$STAGED
STAGED_LIST

if [ -n "$blocked_path" ]; then
  echo "❌ 禁止提交敏感路径：$blocked_path"
  echo "   .env / uploads / 商品档案 属运行期私密内容，已在 .gitignore 中排除。"
  echo "   如确需提交，请先确认无密钥与真实业务数据，并修改 .gitignore。"
  exit 1
fi

# ⚠️ 2026-09-23 修门禁自身缺陷（与 .gitignore 同一个洞）：原模式是 `^database/backup_.*\.sql$`，
#    只覆盖 `backup_` 前缀的**文件名**，漏掉 `database/backup/` 这个**子目录**形态。
#    两个洞方向一致 —— `.gitignore` 不忽略它、这里也不拦它，等于备份文件完全不设防。
#    实测：`database/backup/pre_wallet_points_split_2026-09-23.sql`（135KB，含真实业务数据）
#    是 `??` 未跟踪状态，`git add -A` 即可入库，而 hook 会**放行**。
#    改为同时匹配两种形态：`backup_*.sql`（历史命名）与 `backup/*.sql`（目录形态）。
if echo "$STAGED" | grep -qE "^database/backup_.*\.sql$|^database/backup/.*\.sql$"; then
  echo "❌ 禁止提交数据库备份：含真实业务数据（含客户手机号/银行账号）。"
  echo "   备份只留本地，已在 .gitignore 中排除。"
  exit 1
fi

# ── 2. 暂存文件的 lint 与格式（只跑改动文件）────────────────────────
# ⚠️ 2026-09-18 重要：**不要用 lint-staged**。
#    它在执行前的 "Backing up original state" 步骤会 stash / 改写 ref，
#    在本机 Windows 环境下**必然挂死**；一旦外层进程被超时终止，git 就被杀在
#    「已删旧状态、未写新状态」的中间态 —— 本项目已因此**两次**被破坏：
#      第一次：refs 与 object pack 一起消失（提交"不见了"）；
#      第二次：整个 .git/refs 被删，git 直接报 not a git repository。
#    两次都靠动手前的 `git bundle create --all` 备份恢复。
#    故 pre-commit 只允许做**纯增量**操作：读 git 输出、写文件、git add。
#    执行器见 scripts/precommit-check.mjs（无 stash、无备份、无 ref 操作）。
if [ -f scripts/precommit-check.mjs ]; then
  node scripts/precommit-check.mjs || {
    echo "❌ 暂存文件检查未通过：请修正后重新提交。"
    exit 1
  }
fi

# ── 3. 项目红线扫描（暂存新增行，纯 node、无需依赖）────────────────
if [ -f scripts/check-diff-hazards.mjs ]; then
  node scripts/check-diff-hazards.mjs --staged || {
    echo "❌ 新增代码触发项目红线（详见上方说明）。"
    echo "   判断依据：docs/代码审查标准.md 第三章；确需豁免请在该行加 \`hazard-allow: <原因>\`。"
    exit 1
  }
fi

# ── 4. 前端静态门禁（改动前端时触发；纯静态、无需数据库）──────────
if echo "$STAGED" | grep -qE "^frontend/.*\.(vue|js|css|mjs)$"; then
  if [ -f frontend/scripts/check-script-refs.mjs ]; then
    node frontend/scripts/check-script-refs.mjs || {
      echo "❌ 前端引用检查未通过（<script setup> 中引用了未声明标识符）。"
      exit 1
    }
  fi
fi

if echo "$STAGED" | grep -qE "\.(vue|css)$"; then
  if [ -f backend/scripts/check_frontend_tokens.js ]; then
    node backend/scripts/check_frontend_tokens.js || {
      echo "❌ 视觉 token 门禁未通过（存在硬编码色值）。见 DESIGN.md。"
      exit 1
    }
  fi
fi

# ── 5. 后端冒烟提醒（不阻断，仅提示）────────────────────────────
if echo "$STAGED" | grep -qE "^backend/src/controllers/"; then
  echo "💡 提示：改动 controller 后请重启服务并跑相关冒烟（结果需粘贴到 PR 描述）。"
fi

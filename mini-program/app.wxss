/* ===== 农夫山泉经销商 全局品牌样式 v3.0（苹果级质感） ===== */

/* 品牌色变量（rpx 适配） */
page {
  --nf-red: #C7000B;
  --nf-red-light: #D63344;
  --nf-red-dark: #A00009;
  --nf-red-deep: #7A0007;
  --nf-green: #0B8043;
  --nf-gold: #C5A55A;
  --nf-bg-dark: #1A1A2E;
  --nf-content-bg: #F2F2F7;
  --nf-card-bg: #FFFFFF;
  --nf-text-primary: #1C1C1E;
  --nf-text-secondary: #8E8E93;
  --nf-text-tertiary: #AEAEB2;
  --nf-separator: #E5E5EA;
  --nf-fill: #F2F2F7;
  --nf-fill-secondary: #EFEFF4;

  /* 多层阴影系统 */
  --shadow-card: 0 1rpx 3rpx rgba(0,0,0,0.04), 0 1rpx 2rpx rgba(0,0,0,0.02), 0 0 0 0.5rpx rgba(0,0,0,0.03);
  --shadow-card-elevated: 0 4rpx 16rpx rgba(0,0,0,0.06), 0 2rpx 6rpx rgba(0,0,0,0.03), 0 0 0 0.5rpx rgba(0,0,0,0.04);
  --shadow-modal: 0 -8rpx 40rpx rgba(0,0,0,0.12), 0 -2rpx 8rpx rgba(0,0,0,0.06);
  --shadow-button: 0 6rpx 20rpx rgba(199,0,11,0.3), 0 2rpx 6rpx rgba(199,0,11,0.15), inset 0 1rpx 0 rgba(255,255,255,0.2);
  --shadow-button-pressed: 0 2rpx 8rpx rgba(199,0,11,0.2), inset 0 1rpx 0 rgba(255,255,255,0.15);

  /* 缓动曲线 */
  --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  --ease-smooth: cubic-bezier(0.32, 0.72, 0, 1);

  background: var(--nf-content-bg);
  color: var(--nf-text-primary);
}

/* 通用页面容器 */
.nf-page {
  min-height: 100vh;
  background: var(--nf-content-bg);
  box-sizing: border-box;
  animation: pageEnter 0.45s var(--ease-out);
}

@keyframes pageEnter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ===== 通用卡片：苹果级多层阴影 + 精致质感 ===== */
.nf-card {
  background: var(--nf-card-bg);
  border-radius: 28rpx;
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
  animation: cardEnter 0.55s var(--ease-out) both;
  transition: transform 0.35s var(--ease-out), box-shadow 0.35s var(--ease-out);
  position: relative;
  overflow: hidden;
}

/* 卡片顶部高光线 */
.nf-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8) 50%, transparent);
  pointer-events: none;
}

@keyframes cardEnter {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.97);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* 卡片触摸反馈 */
.nf-card-hover:active {
  transform: scale(0.985);
  transition-duration: 0.1s;
}

/* ===== 主按钮：苹果级渐变 + 多层阴影 + 光泽 ===== */
.nf-btn-primary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #D63344 0%, #C7000B 40%, #A00009 100%);
  color: #fff;
  border-radius: 48rpx;
  font-weight: 600;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  box-shadow: var(--shadow-button);
  border: none;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s var(--ease-out), box-shadow 0.2s var(--ease-out);
}

.nf-btn-primary::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.22), transparent);
  transition: left 0.6s var(--ease-out);
  pointer-events: none;
}

.nf-btn-primary::after {
  border: none;
}

.nf-btn-primary:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-button-pressed);
  transition-duration: 0.1s;
}

/* ===== 次按钮：白底 + 品牌描边 ===== */
.nf-btn-secondary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.9);
  color: var(--nf-red);
  border: 2rpx solid rgba(199,0,11,0.6);
  border-radius: 48rpx;
  font-weight: 600;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: transform 0.2s var(--ease-out);
}

.nf-btn-secondary::after {
  border: none;
}

.nf-btn-secondary:active {
  transform: scale(0.96);
  background: rgba(199,0,11,0.04);
  transition-duration: 0.1s;
}

/* ===== 数字按钮（数量加减）：弹性反馈 ===== */
.nf-qty-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(199,0,11,0.06);
  color: var(--nf-red);
  font-size: 32rpx;
  font-weight: 600;
  transition: transform 0.2s var(--ease-spring), background 0.2s ease;
}

.nf-qty-btn:active {
  transform: scale(0.82);
  background: rgba(199,0,11,0.14);
  transition-duration: 0.08s;
}

/* ===== 通用列表项：staggered 入场 ===== */
.nf-list-item {
  animation: listItemEnter 0.5s var(--ease-out) both;
}

@keyframes listItemEnter {
  0% {
    opacity: 0;
    transform: translateX(-16rpx);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

/* ===== 渐变文字 ===== */
.nf-gradient-text {
  background: linear-gradient(135deg, #C7000B 0%, #D63344 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ===== 浮动按钮（FAB）：呼吸光效 ===== */
.nf-fab {
  position: fixed;
  right: 32rpx;
  bottom: 200rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D63344 0%, #C7000B 50%, #A00009 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow:
    0 12rpx 32rpx rgba(199,0,11,0.35),
    0 4rpx 12rpx rgba(199,0,11,0.18),
    inset 0 2rpx 0 rgba(255,255,255,0.2);
  z-index: 100;
  animation: fabBreathing 3s ease-in-out infinite;
  transition: transform 0.2s var(--ease-out);
}

.nf-fab:active {
  transform: scale(0.88);
  transition-duration: 0.1s;
}

@keyframes fabBreathing {
  0%, 100% {
    box-shadow:
      0 12rpx 32rpx rgba(199,0,11,0.35),
      0 4rpx 12rpx rgba(199,0,11,0.18),
      inset 0 2rpx 0 rgba(255,255,255,0.2);
  }
  50% {
    box-shadow:
      0 16rpx 40rpx rgba(199,0,11,0.45),
      0 6rpx 16rpx rgba(199,0,11,0.22),
      inset 0 2rpx 0 rgba(255,255,255,0.25);
  }
}

/* ===== 标签：圆角 + 微动效 ===== */
.nf-tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: 500;
  background: rgba(199,0,11,0.07);
  color: var(--nf-red);
}

.nf-tag-success {
  background: rgba(11,128,67,0.07);
  color: var(--nf-green);
}

.nf-tag-warning {
  background: rgba(197,165,90,0.1);
  color: #A88842;
}

/* ===== 输入框：聚焦光晕 ===== */
.nf-input {
  background: var(--nf-fill);
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  color: var(--nf-text-primary);
  transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  box-sizing: border-box;
}

.nf-input:focus {
  background: #fff;
  border-color: rgba(199,0,11,0.3);
  box-shadow: 0 0 0 4rpx rgba(199,0,11,0.08);
}

/* ===== 列表触摸反馈 ===== */
.nf-touchable {
  transition: transform 0.2s var(--ease-out), background 0.2s ease;
}

.nf-touchable:active {
  transform: scale(0.98);
  background: rgba(0,0,0,0.02);
  transition-duration: 0.1s;
}

/* ===== 价格高亮 ===== */
.nf-price {
  color: var(--nf-red);
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

/* ===== 数字动画 ===== */
.nf-number-pop {
  animation: numberPop 0.4s var(--ease-spring);
}

@keyframes numberPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.12); }
  100% { transform: scale(1); }
}

/* ===== 加载骨架屏 ===== */
.nf-skeleton {
  background: linear-gradient(90deg, #EFEFF4 25%, #E5E5EA 50%, #EFEFF4 75%);
  background-size: 200% 100%;
  animation: skeleton 1.4s ease-in-out infinite;
  border-radius: 10rpx;
}

@keyframes skeleton {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 滚动条隐藏（小程序原生） ===== */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

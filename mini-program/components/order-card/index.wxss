.order-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
  transition: transform .15s ease;
}
.order-card:active { transform: scale(0.98); }

.oc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.oc-no {
  font-size: 26rpx;
  font-family: 'SFMono-Regular', Menlo, monospace;
  color: #5A5A6E;
  letter-spacing: 1rpx;
}
.oc-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.oc-body { padding: 8rpx 0; }
.oc-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}
.oc-label {
  width: 100rpx;
  font-size: 24rpx;
  color: #8E8E9E;
  flex-shrink: 0;
}
.oc-value {
  font-size: 26rpx;
  color: #1F1F2E;
  flex: 1;
}

.oc-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #EFEFF4;
}
.oc-time { font-size: 22rpx; color: #B8B8C4; }
.oc-amount { font-size: 32rpx; font-weight: 700; }

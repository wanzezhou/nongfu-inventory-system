.section-title {
  padding: 32rpx 40rpx 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1F2E;
  letter-spacing: 2rpx;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  display: inline-block;
  width: 6rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #C7000B, #E63946);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

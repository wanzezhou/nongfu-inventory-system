.delivery-card {
  background: #fff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
  transition: transform .15s ease;
}
.delivery-card:active { transform: scale(0.98); }

.dc-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.dc-no {
  font-size: 26rpx;
  font-family: 'SFMono-Regular', Menlo, monospace;
  color: #5A5A6E;
  letter-spacing: 1rpx;
}
.dc-fee {
  font-size: 26rpx;
  color: #C7000B;
  font-weight: 700;
}

.dc-customer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 10rpx;
}
.dc-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1F2E;
}
.dc-phone {
  font-size: 26rpx;
  color: #3B82F6;
}

.dc-address {
  font-size: 26rpx;
  color: #5A5A6E;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.dc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #F1F1F5;
  padding-top: 16rpx;
}
.dc-time { font-size: 22rpx; color: #B8B8C4; }
.dc-creator { font-size: 22rpx; color: #B8B8C4; }
.dc-accept {
  padding: 12rpx 48rpx;
  background: linear-gradient(135deg, #C7000B, #E63946);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(199, 0, 11, 0.28);
}
.dc-accept:active { transform: scale(0.96); }

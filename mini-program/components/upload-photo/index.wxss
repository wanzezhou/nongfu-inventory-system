.up-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.up-item {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
}
.up-img {
  width: 100%;
  height: 100%;
}
.up-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 38rpx;
  text-align: center;
  background: rgba(15, 23, 42, 0.6);
  color: #fff;
  font-size: 22rpx;
  border-radius: 50%;
}
.up-add {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed #D8D8E2;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #FAFAFC;
}
.up-add-icon {
  font-size: 60rpx;
  color: #B8B8C4;
  line-height: 1;
}
.up-add-text {
  font-size: 22rpx;
  color: #B8B8C4;
  margin-top: 10rpx;
}
.up-hint {
  font-size: 22rpx;
  color: #B8B8C4;
  margin-top: 16rpx;
}

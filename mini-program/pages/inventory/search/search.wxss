.inv-page {
  padding-bottom: 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
}
.search-input {
  flex: 1;
  background: #F6F6F8;
  border-radius: 40rpx;
  height: 72rpx;
  padding: 0 30rpx;
  font-size: 26rpx;
  color: #1F1F2E;
}
.search-btn {
  padding: 0 36rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: linear-gradient(135deg, #C7000B, #E63946);
  color: #fff;
  font-size: 26rpx;
  border-radius: 40rpx;
  font-weight: 600;
}

.inv-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  margin: 16rpx 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
}
.inv-thumb {
  width: 88rpx;
  height: 88rpx;
  border-radius: 14rpx;
  background: #F6F6F8;
  flex-shrink: 0;
}
.inv-info {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}
.inv-name {
  font-size: 28rpx;
  color: #1F1F2E;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.inv-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 8rpx;
}
.inv-code {
  font-size: 20rpx;
  color: #8E8E9E;
  background: #F6F6F8;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}
.inv-spec {
  font-size: 22rpx;
  color: #8E8E9E;
}
.inv-stock {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.inv-status {
  font-size: 20rpx;
}
.inv-status.low { color: #F59E0B; }
.inv-status.out { color: #EF4444; }
.inv-status.sufficient { color: #10B981; }

.list-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #B8B8C4;
}

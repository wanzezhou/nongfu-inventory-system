.mine-page {
  padding-bottom: 40rpx;
}

.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #F1F1F5;
  position: sticky;
  top: 0;
  z-index: 10;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #8E8E9E;
  position: relative;
  transition: color .2s ease;
}
.tab.active {
  color: #C7000B;
  font-weight: 700;
}
.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #C7000B, #E63946);
}

.list-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #B8B8C4;
}

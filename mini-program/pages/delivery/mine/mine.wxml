<view class="mine-page">
  <view class="tabs">
    <view class="tab {{activeTab === index ? 'active' : ''}}"
          wx:for="{{tabs}}" wx:key="status" data-index="{{index}}" bindtap="onTabTap">
      {{item.label}}
    </view>
  </view>

  <view class="mine-list">
    <delivery-card wx:for="{{list}}" wx:key="orderId" order="{{item}}"
                   bind:tap="goDetail" />
    <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无配送订单" />
    <view class="list-tip" wx:if="{{loading}}">加载中...</view>
    <view class="list-tip" wx:if="{{finished && list.length > 0}}">已加载全部</view>
  </view>
</view>

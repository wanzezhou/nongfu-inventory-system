<view class="pending-page">
  <view class="pending-head">
    <view class="ph-title">接单大厅</view>
    <view class="ph-count">待接单 {{list.length}} 单</view>
  </view>

  <view class="pending-list">
    <delivery-card wx:for="{{list}}" wx:key="orderId" order="{{item}}"
                   showAccept="{{role === 'worker'}}"
                   bind:accept="onAccept" bind:tap="goDetail" />
    <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无待接单订单" />
  </view>

  <role-tab-bar></role-tab-bar>
</view>

.pending-page {
  padding-bottom: 160rpx;
}

.pending-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.ph-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F1F2E;
}
.ph-count {
  font-size: 24rpx;
  color: #C7000B;
  background: rgba(199, 0, 11, 0.08);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

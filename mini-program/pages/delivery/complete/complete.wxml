<view class="complete-page" wx:if="{{order}}">
  <view class="card block">
    <view class="block-title">配送订单</view>
    <view class="co-row">
      <text class="co-label">订单号</text>
      <text class="co-value">{{order.orderNo}}</text>
    </view>
    <view class="co-row">
      <text class="co-label">客户</text>
      <text class="co-value">{{order.customerName || '-'}}</text>
    </view>
    <view class="co-row" wx:if="{{order.customerPhone}}">
      <text class="co-label">电话</text>
      <text class="co-value">{{order.customerPhone}}</text>
    </view>
    <view class="co-row" wx:if="{{order.customerAddress}}">
      <text class="co-label">地址</text>
      <text class="co-value">{{order.customerAddress}}</text>
    </view>
    <view class="co-row">
      <text class="co-label">配送费</text>
      <text class="co-value price">¥{{order.deliveryFee}}</text>
    </view>
  </view>

  <view class="card block">
    <view class="block-title">完成照片</view>
    <upload-photo bind:change="onPhotosChange" />
  </view>

  <view class="card block">
    <view class="block-title">备注</view>
    <textarea class="remark-input" placeholder="选填配送备注" value="{{remark}}" bindinput="onRemark" maxlength="200" />
  </view>

  <view class="submit-bar">
    <view class="submit-btn" bindtap="submit">标记完成</view>
  </view>
</view>

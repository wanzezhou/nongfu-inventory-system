.complete-page {
  padding-bottom: 160rpx;
}

.card.block { padding: 24rpx 28rpx; }
.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1F2E;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.block-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #C7000B, #E63946);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.co-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}
.co-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #8E8E9E;
  flex-shrink: 0;
}
.co-value {
  flex: 1;
  font-size: 26rpx;
  color: #1F1F2E;
}

.remark-input {
  width: 100%;
  height: 120rpx;
  font-size: 26rpx;
  color: #1F1F2E;
  padding: 8rpx 0;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #F1F1F5;
  z-index: 100;
}
.submit-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, #C7000B, #E63946);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  box-shadow: 0 8rpx 24rpx rgba(199, 0, 11, 0.3);
}
.submit-btn:active { transform: scale(0.97); }

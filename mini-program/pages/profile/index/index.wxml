<view class="profile-page">
  <view class="profile-head">
    <view class="ph-avatar">
      <image wx:if="{{avatar}}" class="ph-img" src="{{avatar}}" mode="aspectFill" />
      <text wx:else class="ph-emoji">👤</text>
    </view>
    <view class="ph-info">
      <view class="ph-name-row">
        <text class="ph-name">{{name || '未设置昵称'}}</text>
        <text class="ph-role">{{roleText}}</text>
      </view>
      <text class="ph-phone">{{phone || '未绑定手机号'}}</text>
      <text class="ph-station" wx:if="{{stationName}}">{{stationName}}</text>
    </view>
  </view>

  <view class="menu card">
    <view class="menu-item" wx:for="{{menu}}" wx:key="url" data-url="{{item.url}}" bindtap="go">
      <view class="mi-left">
        <text class="mi-icon">{{item.icon}}</text>
        <view class="mi-texts">
          <text class="mi-label">{{item.label}}</text>
          <text class="mi-desc">{{item.desc}}</text>
        </view>
      </view>
      <text class="mi-arrow">›</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="logout">退出登录</view>

  <role-tab-bar></role-tab-bar>
</view>

.profile-page {
  padding-bottom: 160rpx;
}

.profile-head {
  display: flex;
  align-items: center;
  padding: 48rpx 36rpx 40rpx;
  background: linear-gradient(160deg, #C7000B 0%, #E63946 100%);
  border-bottom-left-radius: 36rpx;
  border-bottom-right-radius: 36rpx;
}
.ph-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin-right: 28rpx;
  flex-shrink: 0;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
}
.ph-img {
  width: 100%;
  height: 100%;
}
.ph-emoji {
  font-size: 60rpx;
}
.ph-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.ph-name-row {
  display: flex;
  align-items: center;
}
.ph-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  margin-right: 16rpx;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ph-role {
  font-size: 20rpx;
  color: #C7000B;
  background: #fff;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.ph-phone {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 8rpx;
}
.ph-station {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.menu.card {
  padding: 8rpx 0;
  margin-top: 28rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}
.menu-item:active { background: #FBFBFC; }
.mi-left {
  display: flex;
  align-items: center;
}
.mi-icon {
  font-size: 40rpx;
  margin-right: 22rpx;
}
.mi-texts {
  display: flex;
  flex-direction: column;
}
.mi-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F1F2E;
}
.mi-desc {
  font-size: 22rpx;
  color: #B8B8C4;
  margin-top: 4rpx;
}
.mi-arrow {
  font-size: 44rpx;
  color: #C9C9D4;
  line-height: 1;
}

.logout-btn {
  margin: 48rpx 32rpx 0;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: #fff;
  color: #EF4444;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
}
.logout-btn:active { transform: scale(0.98); }

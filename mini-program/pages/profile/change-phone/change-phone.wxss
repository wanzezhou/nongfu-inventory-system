.change-phone-page {
  padding-bottom: 60rpx;
}

.card.block { padding: 20rpx 28rpx; }
.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1F2E;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}
.block-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #C7000B, #E63946);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}
.form-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #5A5A6E;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F1F2E;
}

.save-btn {
  margin: 48rpx 32rpx 0;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  background: linear-gradient(135deg, #C7000B, #E63946);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
  box-shadow: 0 8rpx 24rpx rgba(199, 0, 11, 0.28);
}
.save-btn:active { transform: scale(0.98); }

.save-tip {
  text-align: center;
  font-size: 22rpx;
  color: #B8B8C4;
  margin-top: 20rpx;
}

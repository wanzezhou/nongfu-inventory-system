<view class="deposit-list-page">
  <view class="list-head">
    <view class="lh-title">桶押金记录</view>
    <view class="lh-add" bindtap="goCreate">＋ 登记押金</view>
  </view>

  <view class="d-item card" wx:for="{{list}}" wx:key="id">
    <view class="d-head">
      <text class="d-station">{{item.stationName || '未知水站'}}</text>
      <view class="d-type {{item.depositType === 'return' ? 'return' : 'collect'}}">{{item.depositTypeText}}</view>
    </view>
    <view class="d-body">
      <view class="d-row">
        <text class="d-label">桶类型</text>
        <text class="d-value">{{item.barrelType || '-'}}</text>
      </view>
      <view class="d-row">
        <text class="d-label">数量</text>
        <text class="d-value">{{item.quantity}} 桶</text>
      </view>
      <view class="d-row">
        <text class="d-label">单价</text>
        <text class="d-value price">¥{{item.unitPrice}}</text>
      </view>
      <view class="d-row">
        <text class="d-label">金额</text>
        <text class="d-value price">¥{{item.quantity * item.unitPrice}}</text>
      </view>
      <view class="d-row">
        <text class="d-label">经办人</text>
        <text class="d-value">{{item.handlerName || '-'}}</text>
      </view>
    </view>
    <view class="d-foot">
      <text class="d-time">{{item.createdAt || ''}}</text>
      <text class="d-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
    </view>
  </view>

  <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无押金记录" />
  <view class="list-tip" wx:if="{{loading}}">加载中...</view>
  <view class="list-tip" wx:if="{{finished && list.length > 0}}">已加载全部</view>
</view>

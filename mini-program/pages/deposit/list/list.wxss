.deposit-list-page {
  padding-bottom: 40rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 8rpx;
}
.lh-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F1F2E;
}
.lh-add {
  font-size: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #C7000B, #E63946);
  padding: 12rpx 28rpx;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 16rpx rgba(199, 0, 11, 0.25);
}

.d-item {
  padding: 24rpx 28rpx;
  margin: 16rpx 24rpx;
}
.d-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.d-station {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F1F2E;
}
.d-type {
  font-size: 22rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
}
.d-type.collect { background: rgba(16, 185, 129, 0.12); color: #10B981; }
.d-type.return { background: rgba(245, 158, 11, 0.12); color: #F59E0B; }

.d-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
}
.d-label {
  width: 130rpx;
  font-size: 26rpx;
  color: #8E8E9E;
  flex-shrink: 0;
}
.d-value {
  flex: 1;
  font-size: 26rpx;
  color: #1F1F2E;
}

.d-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #F6F6F8;
  margin-top: 12rpx;
  padding-top: 14rpx;
}
.d-time { font-size: 22rpx; color: #B8B8C4; }
.d-remark {
  font-size: 22rpx;
  color: #8E8E9E;
  max-width: 50%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #B8B8C4;
}

<view class="page">
  <!-- Hero 区：多层渐变 + 装饰光斑 -->
  <view class="hero">
    <view class="hero-deco-circle deco-1"></view>
    <view class="hero-deco-circle deco-2"></view>
    <view class="hero-content">
      <text class="hero-brand">农夫山泉经销商</text>
      <view class="success-ring">
        <view class="success-inner">
          <text class="success-check">✓</text>
        </view>
      </view>
      <text class="hero-title">订单提交成功</text>
      <text class="hero-sub">订单已发送至后台，工作人员会尽快处理</text>
    </view>
  </view>

  <view class="content" wx:if="{{order}}">
    <!-- 订单概要卡片 -->
    <view class="summary-card">
      <view class="summary-main">
        <view class="summary-item">
          <text class="summary-label">订单编号</text>
          <text class="summary-value order-no">{{order.orderNo}}</text>
        </view>
        <view class="summary-item" wx:if="{{order.orderTypeName}}">
          <text class="summary-label">订单类型</text>
          <text class="summary-value">{{order.orderTypeName}}</text>
        </view>
        <view class="summary-item">
          <text class="summary-label">下单时间</text>
          <text class="summary-value">{{order.createTime}}</text>
        </view>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-amount">
        <text class="amount-label">应收总额</text>
        <text class="amount-price">¥{{order.totalAmountStr}}</text>
      </view>
    </view>

    <!-- 客户信息卡片 -->
    <view class="card">
      <view class="card-header">
        <view class="card-accent-bar"></view>
        <text class="card-title">客户信息</text>
      </view>
      <view class="info-row" wx:if="{{order.creatorName}}">
        <text class="info-label">创建人</text>
        <text class="info-value">{{order.creatorName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">客户姓名</text>
        <text class="info-value">{{order.customerName}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">联系电话</text>
        <text class="info-value">{{order.customerPhone}}</text>
      </view>
      <view class="info-row" wx:if="{{order.customerAddress}}">
        <text class="info-label">配送地址</text>
        <text class="info-value">{{order.customerAddress}}</text>
      </view>
      <view class="info-row" wx:if="{{order.remark}}">
        <text class="info-label">备注</text>
        <text class="info-value">{{order.remark}}</text>
      </view>
    </view>

    <!-- 商品明细卡片 -->
    <view class="card">
      <view class="card-header">
        <view class="card-accent-bar"></view>
        <text class="card-title">商品明细</text>
      </view>
      <view class="goods-list">
        <view wx:for="{{order.items}}" wx:key="id" class="goods-item">
          <view class="goods-left">
            <view class="goods-avatar">{{item.productName[0]}}</view>
            <view class="goods-info">
              <text class="goods-name">{{item.productName}}</text>
              <text class="goods-spec">{{item.spec}}</text>
            </view>
          </view>
          <view class="goods-right">
            <text class="goods-price">¥{{item.unitPriceStr}} × {{item.quantity}}</text>
            <text class="goods-subtotal">¥{{item.subtotalStr}}</text>
          </view>
        </view>
      </view>
      <view class="fee-list">
        <view class="fee-row">
          <text>商品金额</text>
          <text>¥{{order.orderAmountStr}}</text>
        </view>
        <view class="fee-row">
          <text>配送费</text>
          <text>¥{{order.deliveryFeeStr}}</text>
        </view>
        <view class="fee-row total">
          <text>应收总额</text>
          <text>¥{{order.totalAmountStr}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-bar">
    <button class="btn btn-outline" bindtap="editOrder">修改订单</button>
    <button class="btn btn-secondary" bindtap="newOrder">继续下单</button>
    <button class="btn btn-primary" bindtap="shareOrder">分享订单</button>
  </view>
</view>

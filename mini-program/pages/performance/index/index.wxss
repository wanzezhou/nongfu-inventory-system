.perf-page {
  padding-bottom: 60rpx;
}

.period-tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #F1F1F5;
  position: sticky;
  top: 0;
  z-index: 10;
}
.ptab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 26rpx;
  color: #8E8E9E;
  position: relative;
}
.ptab.active {
  color: #C7000B;
  font-weight: 700;
}
.ptab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, #C7000B, #E63946);
}

.stat-grid {
  display: grid;
  gap: 20rpx;
  padding: 24rpx;
}
.stat-grid.grid-2 { grid-template-columns: repeat(2, 1fr); }
.stat-grid.grid-1 { grid-template-columns: repeat(1, 1fr); }

.stat-box {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.stat-box.full { margin: 0 24rpx; }
.sb-label {
  font-size: 24rpx;
  color: #8E8E9E;
}
.sb-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #1F1F2E;
}
.sb-sub {
  font-size: 24rpx;
  color: #B8B8C4;
}

.section-title {
  padding: 24rpx 40rpx 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1F2E;
  display: flex;
  align-items: center;
}
.section-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #C7000B, #E63946);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.rank-card { padding: 12rpx 28rpx; }
.rank-row {
  display: grid;
  grid-template-columns: 56rpx 2fr 2fr;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F6F6F8;
}
.rank-row:last-child { border-bottom: none; }
.rank-no {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #F1F1F5;
  color: #8E8E9E;
  font-size: 22rpx;
  font-weight: 700;
}
.rank-row:nth-child(1) .rank-no { background: linear-gradient(135deg, #F59E0B, #FBBF24); color: #fff; }
.rank-row:nth-child(2) .rank-no { background: linear-gradient(135deg, #94A3B8, #CBD5E1); color: #fff; }
.rank-row:nth-child(3) .rank-no { background: linear-gradient(135deg, #D97706, #F59E0B); color: #fff; }
.rank-name {
  font-size: 28rpx;
  color: #1F1F2E;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rank-val {
  font-size: 24rpx;
  color: #5A5A6E;
  text-align: right;
}

.list-card { padding: 12rpx 28rpx; }
.perf-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F6F6F8;
}
.perf-row:last-child { border-bottom: none; }
.pr-no {
  font-size: 24rpx;
  font-family: 'SFMono-Regular', Menlo, monospace;
  color: #5A5A6E;
}
.pr-name {
  font-size: 26rpx;
  color: #1F1F2E;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.pr-fee {
  font-size: 30rpx;
  font-weight: 700;
}

.loading-tip {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #B8B8C4;
}

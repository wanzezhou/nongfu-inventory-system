<view class="perf-page">
  <view class="period-tabs">
    <view class="ptab {{periodIndex === index ? 'active' : ''}}"
          wx:for="{{periods}}" wx:key="value" data-index="{{index}}" bindtap="onPeriodTap">
      {{item.label}}
    </view>
  </view>

  <!-- Admin -->
  <block wx:if="{{role === 'admin' && data}}">
    <view class="stat-grid grid-2">
      <view class="card stat-box">
        <text class="sb-label">订单数</text>
        <text class="sb-value">{{data.totalOrders || 0}} 单</text>
      </view>
      <view class="card stat-box">
        <text class="sb-label">销售额</text>
        <text class="sb-value price">¥{{data.totalSales || 0}}</text>
      </view>
    </view>
    <view class="section-title">配送员排行 Top5</view>
    <view class="card rank-card" wx:if="{{data.top5Workers.length > 0}}">
      <view class="rank-row" wx:for="{{data.top5Workers}}" wx:key="workerId">
        <text class="rank-no">{{index + 1}}</text>
        <text class="rank-name">{{item.workerName || '-'}}</text>
        <text class="rank-val">{{item.deliveryCount}}单 / ¥{{item.totalFee}}</text>
      </view>
    </view>
    <empty-state wx:else text="暂无配送数据" />
    <view class="section-title">业务员排行 Top5</view>
    <view class="card rank-card" wx:if="{{data.top5Salesmen.length > 0}}">
      <view class="rank-row" wx:for="{{data.top5Salesmen}}" wx:key="salesmanId">
        <text class="rank-no">{{index + 1}}</text>
        <text class="rank-name">{{item.salesmanName || '-'}}</text>
        <text class="rank-val">{{item.orderCount}}单 / ¥{{item.salesAmount}}</text>
      </view>
    </view>
    <empty-state wx:else text="暂无业务员数据" />
  </block>

  <!-- Worker -->
  <block wx:if="{{role === 'worker' && data}}">
    <view class="stat-grid grid-2">
      <view class="card stat-box">
        <text class="sb-label">我的配送</text>
        <text class="sb-value">{{data.myDeliveryCount || 0}} 单</text>
      </view>
      <view class="card stat-box">
        <text class="sb-label">配送费</text>
        <text class="sb-value price">¥{{data.totalDeliveryFee || 0}}</text>
      </view>
    </view>
    <view class="section-title">配送明细</view>
    <view class="card list-card" wx:if="{{data.detail.length > 0}}">
      <view class="perf-row" wx:for="{{data.detail}}" wx:key="orderId" bindtap="goDetail" data-id="{{item.orderId}}">
        <view class="pr-info">
          <view class="pr-no">{{item.orderId}}</view>
          <view class="pr-name">{{item.customerName || '-'}}</view>
        </view>
        <view class="pr-fee price">¥{{item.deliveryFee}}</view>
      </view>
    </view>
    <empty-state wx:else text="暂无配送记录" />
  </block>

  <!-- Station -->
  <block wx:if="{{role === 'station' && data}}">
    <view class="stat-grid grid-2">
      <view class="card stat-box">
        <text class="sb-label">分销额</text>
        <text class="sb-value price">¥{{data.distribAmount || 0}}</text>
        <text class="sb-sub">{{data.distribCount || 0}} 单</text>
      </view>
      <view class="card stat-box">
        <text class="sb-label">返货额</text>
        <text class="sb-value price">¥{{data.returnAmount || 0}}</text>
        <text class="sb-sub">{{data.returnCount || 0}} 单</text>
      </view>
    </view>
    <view class="stat-grid grid-1">
      <view class="card stat-box">
        <text class="sb-label">订单总数</text>
        <text class="sb-value">{{data.orderCount || 0}} 单</text>
      </view>
    </view>
  </block>

  <!-- Salesman -->
  <block wx:if="{{role === 'salesman' && data}}">
    <view class="stat-grid grid-2">
      <view class="card stat-box">
        <text class="sb-label">我的开单</text>
        <text class="sb-value">{{data.myOrderCount || 0}} 单</text>
      </view>
      <view class="card stat-box">
        <text class="sb-label">销售额</text>
        <text class="sb-value price">¥{{data.totalSales || 0}}</text>
      </view>
    </view>
    <view class="card stat-box full">
      <text class="sb-label">预计佣金（{{data.commissionRate || 0}}%）</text>
      <text class="sb-value price">¥{{data.commissionAmount || 0}}</text>
    </view>
    <view class="section-title">开单明细</view>
    <view class="card list-card" wx:if="{{data.detail.length > 0}}">
      <view class="perf-row" wx:for="{{data.detail}}" wx:key="orderId" bindtap="goDetail" data-id="{{item.orderId}}">
        <view class="pr-info">
          <view class="pr-no">{{item.orderId}}</view>
          <view class="pr-name">{{item.customerName || '-'}}</view>
        </view>
        <view class="pr-fee price">¥{{item.totalAmount}}</view>
      </view>
    </view>
    <empty-state wx:else text="暂无开单记录" />
  </block>

  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
</view>

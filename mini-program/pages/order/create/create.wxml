<view class="create-page">

  <view class="card block">
    <view class="form-row">
      <text class="form-label">订单类型</text>
      <picker range="{{orderTypes}}" range-key="label" value="{{orderTypeIndex}}" bindchange="onOrderTypeChange">
        <view class="form-value {{orderType ? '' : 'placeholder'}}">{{typeLabel || '请选择订单类型'}}</view>
      </picker>
    </view>
  </view>

  <view class="card block" wx:if="{{showStation}}">
    <view class="block-title">水站信息</view>
    <view class="form-row">
      <text class="form-label">选择水站</text>
      <picker range="{{stations}}" range-key="name" value="{{stationIndex}}" bindchange="onStationChange">
        <view class="form-value {{stationId ? '' : 'placeholder'}}">{{stationIndex > -1 ? stations[stationIndex].name : '请选择水站'}}</view>
      </picker>
    </view>
    <view class="station-tip">选择水站后自动带出联系人、电话、地址</view>
  </view>

  <view class="card block">
    <view class="block-title">客户信息</view>
    <view class="form-row">
      <text class="form-label">客户名称</text>
      <input class="form-input" placeholder="请输入客户名称" value="{{customerName}}" bindinput="onCustomerName" />
    </view>
    <view class="form-row" wx:if="{{orderType !== 4}}">
      <text class="form-label">联系电话</text>
      <input class="form-input" type="number" placeholder="请输入联系电话" value="{{customerPhone}}" bindinput="onCustomerPhone" />
    </view>
    <view class="form-row">
      <text class="form-label">配送地址</text>
      <input class="form-input" placeholder="请输入配送地址" value="{{customerAddress}}" bindinput="onCustomerAddress" />
    </view>
  </view>

  <view class="card block">
    <view class="block-title">商品明细</view>
    <view class="picker-entry" bindtap="openPicker">
      <text class="entry-text">{{orderItems.length > 0 ? '已选 ' + orderItems.length + ' 种商品' : '点击选择商品'}}</text>
      <text class="entry-arrow">›</text>
    </view>
    <view class="selected-item" wx:for="{{orderItems}}" wx:key="productId">
      <view class="si-info">
        <view class="si-name">{{item.name}}</view>
        <view class="si-meta">¥{{item.unitPrice}} × {{item.qty}}</view>
      </view>
      <view class="si-subtotal price">¥{{item.subtotal}}</view>
      <view class="si-del" catchtap="removeItem" data-index="{{index}}">✕</view>
    </view>
    <view class="amount-row">
      <text class="amount-label">商品金额</text>
      <text class="amount-value">¥{{goodsAmount}}</text>
    </view>
  </view>

  <view class="card block">
    <view class="block-title">备注</view>
    <textarea class="remark-input" placeholder="选填" value="{{remark}}" bindinput="onRemark" maxlength="200" />
  </view>

  <view class="card block">
    <view class="block-title">配送信息</view>
    <view class="form-row">
      <text class="form-label">配送方式</text>
      <picker range="{{deliveryTypes}}" range-key="label" value="{{deliveryTypeIndex}}" bindchange="onDeliveryTypeChange">
        <view class="form-value {{deliveryType ? '' : 'placeholder'}}">{{deliveryLabel || '请选择配送方式'}}</view>
      </picker>
    </view>
    <view class="form-row" wx:if="{{needWorker}}">
      <text class="form-label">配送员工</text>
      <picker range="{{workers}}" range-key="name" value="{{workerIndex}}" bindchange="onWorkerChange">
        <view class="form-value {{workerId ? '' : 'placeholder'}}">{{workerIndex > -1 ? workers[workerIndex].name : '请选择配送员工'}}</view>
      </picker>
    </view>
    <view class="amount-row">
      <text class="amount-label">配送费</text>
      <text class="amount-value">¥{{deliveryFee}}</text>
    </view>
  </view>

  <view class="submit-bar">
    <view class="submit-total">
      <text class="st-label">合计</text>
      <text class="st-value price">¥{{totalAmount}}</text>
    </view>
    <view class="submit-btn" bindtap="submit">提交订单</view>
  </view>

  <product-picker visible="{{showPicker}}" orderType="{{orderType}}"
                  externalItems="{{orderItems}}"
                  bind:confirm="onPickerConfirm" bind:close="closePicker" />
</view>

.detail-page {
  padding-bottom: 160rpx;
}

.status-banner {
  margin: 24rpx;
  border-radius: 24rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, #C7000B, #E63946);
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(199, 0, 11, 0.28);
}
.status-banner.info { background: linear-gradient(135deg, #3B82F6, #60A5FA); box-shadow: 0 12rpx 40rpx rgba(59,130,246,0.25); }
.status-banner.success { background: linear-gradient(135deg, #10B981, #34D399); box-shadow: 0 12rpx 40rpx rgba(16,185,129,0.25); }
.status-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.status-text {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}
.status-type {
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  padding: 4rpx 20rpx;
  border-radius: 20rpx;
}
.status-no {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
  font-family: 'SFMono-Regular', Menlo, monospace;
}

.card.block { padding: 24rpx 28rpx; }
.block-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1F1F2E;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}
.block-title::before {
  content: '';
  width: 6rpx;
  height: 26rpx;
  background: linear-gradient(180deg, #C7000B, #E63946);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}
.info-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #8E8E9E;
  flex-shrink: 0;
}
.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1F1F2E;
}

.item-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1F1F5;
}
.item-row:last-of-type { border-bottom: none; }
.item-info { flex: 1; min-width: 0; }
.item-name {
  font-size: 28rpx;
  color: #1F1F2E;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.item-meta { font-size: 22rpx; color: #8E8E9E; margin-top: 6rpx; }
.item-right { text-align: right; }
.item-price { font-size: 24rpx; color: #8E8E9E; }
.item-subtotal { font-size: 28rpx; margin-top: 4rpx; }

.amount-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}
.amount-label { font-size: 26rpx; color: #8E8E9E; }
.amount-value { font-size: 26rpx; color: #1F1F2E; }
.amount-row.total {
  border-top: 1rpx solid #F1F1F5;
  margin-top: 8rpx;
  padding-top: 20rpx;
}
.amount-row.total .amount-value {
  font-size: 36rpx;
  font-weight: 800;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #F1F1F5;
  z-index: 100;
}
.bottom-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.bottom-btn.edit {
  background: #fff;
  color: #C7000B;
  border: 1rpx solid rgba(199, 0, 11, 0.4);
}
.bottom-btn.deliver {
  background: linear-gradient(135deg, #C7000B, #E63946);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(199, 0, 11, 0.3);
}
.bottom-btn:active { transform: scale(0.98); }

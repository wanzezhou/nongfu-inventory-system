.approve-page {
  padding-bottom: 60rpx;
}

.page-tip {
  padding: 24rpx 32rpx 0;
  font-size: 24rpx;
  color: #8E8E9E;
}

.a-item {
  padding: 24rpx 28rpx;
  margin: 16rpx 24rpx;
}
.a-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.a-title { display: flex; align-items: center; }
.a-type {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F1F2E;
  margin-right: 16rpx;
}
.a-amount { font-size: 34rpx; font-weight: 800; }
.a-desc {
  font-size: 26rpx;
  color: #5A5A6E;
  margin-bottom: 6rpx;
}
.a-attach {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  margin: 10rpx 0;
  background: #FAFAFC;
  border-radius: 16rpx;
}
.aa-icon { font-size: 26rpx; }
.aa-count {
  font-size: 24rpx;
  color: #5A5A6E;
  margin-right: 8rpx;
}
.aa-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: #eee;
}
.aa-more {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  background: #EFEFF4;
  color: #8E8E9E;
  border-radius: 10rpx;
  font-size: 22rpx;
}
.a-time { font-size: 22rpx; color: #B8B8C4; }
.a-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}
.a-btn {
  font-size: 26rpx;
  padding: 12rpx 40rpx;
  border-radius: 36rpx;
  margin-left: 20rpx;
  font-weight: 600;
}
.a-btn.reject {
  color: #EF4444;
  background: rgba(239, 68, 68, 0.08);
}
.a-btn.approve {
  color: #fff;
  background: linear-gradient(135deg, #10B981, #059669);
  box-shadow: 0 6rpx 16rpx rgba(16, 185, 129, 0.25);
}
.a-btn:active { transform: scale(0.97); }

.list-tip {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #B8B8C4;
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 200;
}
.action-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx;
  padding-bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 201;
  transform: translateY(105%);
  transition: transform .25s ease;
}
.action-panel.show { transform: translateY(0); }

.ap-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F1F2E;
  text-align: center;
  margin-bottom: 28rpx;
}
.ap-amount {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F6F6F8;
}
.ap-remark {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F6F6F8;
}
.ap-label {
  width: 150rpx;
  font-size: 26rpx;
  color: #5A5A6E;
  flex-shrink: 0;
}
.ap-amount-in { flex: 1; display: flex; align-items: center; }
.ap-symbol { font-size: 28rpx; color: #B8B8C4; margin-right: 8rpx; }
.ap-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F1F2E;
}
.ap-confirm {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 46rpx;
}
.ap-confirm.green {
  background: linear-gradient(135deg, #10B981, #059669);
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}
.ap-confirm.red {
  background: linear-gradient(135deg, #EF4444, #DC2626);
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.3);
}
.ap-confirm:active { transform: scale(0.98); }

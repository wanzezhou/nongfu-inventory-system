<view class="approve-page">
  <view class="page-tip" wx:if="{{list.length > 0}}">共 {{total}} 条待审核报销</view>

  <view class="a-item card" wx:for="{{list}}" wx:key="id">
    <view class="a-head">
      <view class="a-title">
        <text class="a-type">{{item.type || '报销'}}</text>
        <text class="tag tag-warning">待审核</text>
      </view>
      <text class="a-amount price">{{item.amountText}}</text>
    </view>
    <view class="a-desc" wx:if="{{item.desc}}">{{item.desc}}</view>
    <view class="a-attach" wx:if="{{item.attachCount > 0}}" data-id="{{item.id}}" bindtap="previewAttach">
      <text class="aa-icon">📎</text>
      <text class="aa-count">{{item.attachCount}} 张附件</text>
      <image wx:for="{{item.attachPreview}}" wx:for-item="img" wx:key="*this"
             class="aa-thumb" src="{{img}}" mode="aspectFill" />
      <text class="aa-more" wx:if="{{item.attachCount > 3}}">+{{item.attachCount - 3}}</text>
    </view>
    <view class="a-time">{{item.createdAt || ''}}</view>
    <view class="a-actions">
      <view class="a-btn reject" data-id="{{item.id}}" bindtap="onReject">拒绝</view>
      <view class="a-btn approve" data-id="{{item.id}}" bindtap="onApprove">通过</view>
    </view>
  </view>

  <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无待审核报销" />
  <view class="list-tip" wx:if="{{loading}}">加载中...</view>
  <view class="list-tip" wx:if="{{finished && list.length > 0}}">已加载全部</view>

  <!-- 审批操作面板 -->
  <view class="mask" wx:if="{{panelVisible}}" bindtap="closePanel"></view>
  <view class="action-panel {{panelVisible ? 'show' : ''}}" catchtap="noop">
    <view class="ap-title">{{panelMode === 'approve' ? '通过报销' : '拒绝报销'}}</view>
    <view class="ap-amount" wx:if="{{panelMode === 'approve'}}">
      <text class="ap-label">批复金额</text>
      <view class="ap-amount-in">
        <text class="ap-symbol">¥</text>
        <input class="ap-input" type="digit" value="{{approvedAmount}}" bindinput="onAmount" placeholder="请输入批复金额" />
      </view>
    </view>
    <view class="ap-remark">
      <text class="ap-label">审批备注</text>
      <input class="ap-input" value="{{remark}}" bindinput="onRemark" placeholder="选填" />
    </view>
    <view class="ap-confirm {{panelMode === 'approve' ? 'green' : 'red'}}" bindtap="confirmAction">
      {{panelMode === 'approve' ? '确认通过' : '确认拒绝'}}
    </view>
  </view>
</view>

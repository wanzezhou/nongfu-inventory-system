<view class="reimburse-page">
  <view class="list-head">
    <view class="lh-title">报销记录</view>
    <view class="lh-actions">
      <view class="lh-btn" wx:if="{{isAdmin}}" bindtap="goApprove">审批</view>
      <view class="lh-btn primary" bindtap="goCreate">＋ 提交报销</view>
    </view>
  </view>

  <view class="r-item card" wx:for="{{list}}" wx:key="id">
    <view class="r-head">
      <view class="r-title">
        <text class="r-type">{{item.type || '报销'}}</text>
        <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
      </view>
      <text class="r-amount price">{{item.amountText}}</text>
    </view>
    <view class="r-desc" wx:if="{{item.description}}">{{item.description}}</view>
    <view class="r-row" wx:if="{{item.approvedText}}">
      <text class="r-label">批复金额</text>
      <text class="r-value price">{{item.approvedText}}</text>
    </view>
    <view class="r-row" wx:if="{{item.remark}}">
      <text class="r-label">备注</text>
      <text class="r-value">{{item.remark}}</text>
    </view>
    <view class="r-foot">
      <text class="r-time">{{item.createdAt || ''}}</text>
    </view>
  </view>

  <empty-state wx:if="{{!loading && list.length === 0}}" text="暂无报销记录" />
  <view class="list-tip" wx:if="{{loading}}">加载中...</view>
  <view class="list-tip" wx:if="{{finished && list.length > 0}}">已加载全部</view>
</view>

<view class="tool-page">
  <view class="tool-head">
    <view class="th-title">🧰 工具箱</view>
    <view class="th-sub">常用功能快捷入口</view>
  </view>

  <view class="tool-grid">
    <view class="tool-item" wx:for="{{tools}}" wx:key="url" data-url="{{item.url}}" bindtap="go">
      <view class="ti-icon">{{item.icon}}</view>
      <view class="ti-label">{{item.label}}</view>
      <view class="ti-desc">{{item.desc}}</view>
    </view>
  </view>

  <role-tab-bar></role-tab-bar>
</view>

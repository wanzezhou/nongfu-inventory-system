.tool-page {
  padding: 0 0 160rpx;
}

.tool-head {
  padding: 40rpx 40rpx 24rpx;
  background:
    radial-gradient(ellipse at top right, rgba(199, 0, 11, 0.12), transparent 55%),
    linear-gradient(180deg, #FFFFFF 0%, #F6F6F8 100%);
}
.th-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1A1A2E;
}
.th-sub {
  font-size: 24rpx;
  color: #8E8E9E;
  margin-top: 8rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  padding: 0 24rpx;
}
.tool-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 20rpx rgba(15, 23, 42, 0.04);
  transition: transform .15s ease;
}
.tool-item:active { transform: scale(0.96); }
.ti-icon { font-size: 60rpx; margin-bottom: 16rpx; }
.ti-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #1F1F2E;
}
.ti-desc {
  font-size: 22rpx;
  color: #8E8E9E;
  margin-top: 8rpx;
}

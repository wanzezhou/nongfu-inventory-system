{
  "name": "nongfu-distributor-system",
  "version": "1.0.0",
  "private": true,
  "description": "农夫山泉经销商业务管理系统 —— 仓库根级工具链（代码审查门禁 G2）。业务代码在 backend/ 与 frontend/，各自的依赖独立安装。",
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings 40",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hazards": "node scripts/check-diff-hazards.mjs --all",
    "hazards:staged": "node scripts/check-diff-hazards.mjs --staged",
    "gates": "node scripts/check-diff-hazards.mjs --staged && node frontend/scripts/check-script-refs.mjs && node backend/scripts/check_frontend_tokens.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.8",
    "vue-eslint-parser": "^10.4.1"
  }
}

# 服务端口
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=nongfu_inventory

# 微信小程序配置（文档 §51：小程序令牌必须与 Web 令牌隔离）
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# ⚠️ 小程序令牌**专用**密钥 —— 必须与 JWT_SECRET 不同（文档 §51.2 第 1 条硬要求）。
#    缺失时后端拒绝启动（§51.3：不留 fallback 默认串）。
#    Web 的 auth/requireAdmin 会显式拒绝用本密钥签发的令牌，反向亦然。
JWT_SECRET_MINI=please_replace_with_a_strong_random_hex_string

# 小程序令牌有效期（§4.5.1 建议 ≤ 2h）
MINI_TOKEN_TTL=2h

# ⚠️ 本地开发登录开关：仅供无真实 AppID 时在开发者工具中联调。
#    **生产环境必须删除或置 0**。
MINI_DEV_LOGIN=0

# 短信服务配置
SMS_API_KEY=your_sms_api_key
SMS_API_URL=https://sms.api.com/send
SMS_SIGN_NAME=农夫山泉
SMS_TEMPLATE_CODE=SMS_123456

# JWT密钥（必填！生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
JWT_SECRET=please_replace_with_a_strong_random_hex_string

# CORS 允许的前端来源（逗号分隔多个，如 http://localhost:5173,https://your-domain.com）
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# 生产环境变量模板 —— 复制为 backend/.env 后逐项修改
#   cp deploy/backend.env.production.example backend/.env
#   chmod 600 backend/.env
#
# ⚠️ 不要直接把本机开发用的 backend/.env 拷到服务器 —— 里面的密钥、CORS 来源、
#    小程序开发登录开关都是本机专用的。
# ============================================================================

# ---------- 服务端口（保持 3000；nginx 反代到这里，不对公网暴露）----------
PORT=3000

# ---------- 数据库 ----------
# 用第 2.2 步创建的**应用专用账号**，不要用 root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nongfu
DB_PASSWORD=CHANGE_ME_TO_YOUR_DB_PASSWORD
DB_NAME=nongfu_inventory

# 连接池（一般不用改；小内存机器可把 DB_CONNECTION_LIMIT 降到 5）
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=50
DB_CONNECT_TIMEOUT=10000
DB_IDLE_TIMEOUT=60000

# ---------- JWT 密钥（⚠️ 必填，且两个必须不同）----------
# 生成方式（执行两次，各取一条结果）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_RANDOM_HEX_32_BYTES_A
JWT_SECRET_MINI=CHANGE_ME_RANDOM_HEX_32_BYTES_B

# 小程序令牌有效期
MINI_TOKEN_TTL=2h

# ---------- ⚠️⚠️ 生产环境必须关闭本地开发登录 ----------
# 置 1 会绕过微信身份校验，任何人可用手机号直接登录真实账号。
MINI_DEV_LOGIN=0

# ---------- 微信小程序凭据（不用小程序可留空）----------
WX_APPID=
WX_SECRET=

# ---------- CORS 白名单（英文逗号分隔，务必填真实访问地址）----------
# 同域部署（走 nginx）时浏览器不会发跨域请求，但 /uploads 目录的来源守卫依赖它，
# 所以**必须填真实域名**，否则上传的配送照片/凭证会被 403。
CORS_ORIGIN=https://CHANGE_ME_your-domain.com

# ---------- 短信服务（若未接入可留空）----------
SMS_API_KEY=
SMS_API_URL=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ---------- 可选：应急逃生阀（不推荐开启）----------
# 置 1 会让 /uploads 目录对所有来源公开，仅用于排查问题
# UPSERVE_UPLOADS_PUBLIC=0
